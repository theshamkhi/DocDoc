<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="DocDocPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entities -->
        <class>com.docdoc.docdoc.model.Admin</class>
        <class>com.docdoc.docdoc.model.User</class>
        <class>com.docdoc.docdoc.model.Infirmier</class>
        <class>com.docdoc.docdoc.model.MedecinGeneraliste</class>
        <class>com.docdoc.docdoc.model.MedecinSpecialiste</class>
        <class>com.docdoc.docdoc.model.Patient</class>
        <class>com.docdoc.docdoc.model.SigneVital</class>
        <class>com.docdoc.docdoc.model.Consultation</class>
        <class>com.docdoc.docdoc.model.DemandeExpertise</class>
        <class>com.docdoc.docdoc.model.Creneau</class>
        <class>com.docdoc.docdoc.model.ActeTechnique</class>


        <properties>
            <!-- JDBC Configuration -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/DocDoc"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="123"/>

            <!-- Hibernate Configuration -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Affichage SQL -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.use_sql_comments" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
